# The runner, this box's confiner and what a fetch runs (frontseat-place),
# where every runner sandbox holds them (/bb); the runner is put in place
# whole, never written over one a sandbox runs.
if { cp /opt/frontseat/bin/frontseat-runner /var/lib/frontseat/bb/.frontseat-runner }
if { mv /var/lib/frontseat/bb/.frontseat-runner /var/lib/frontseat/bb/frontseat-runner }
if { frontseat-action install /var/lib/frontseat/bb }
frontseat-place install /var/lib/frontseat/bb
